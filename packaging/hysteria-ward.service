[Unit]
Description=Hysteria Ward — панель управления сервером Hysteria 2
Documentation=https://github.com/vibecodinguser/hysteria-ward
After=network-online.target
Wants=network-online.target

# Панель без сертификата или с занятым портом падает сразу. Без предела systemd
# перезапускал бы её бесконечно и забивал журнал; после пяти отказов за минуту
# служба останавливается, и причина видна в systemctl status.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=hysteria-ward
Group=hysteria-ward
WorkingDirectory=/var/lib/hysteria-ward
ExecStart=/usr/local/bin/hysteria-ward serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

# Файлы базы, журнала и сертификатов не должны быть доступны посторонним.
UMask=0077

# Ядро слушает UDP 443, панель — 8443. Служба работает не от root и получает
# только право занять привилегированный порт: без него ядро не сможет открыть 443,
# а будущий ACME — 80.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Запись разрешена только туда, где панель действительно хранит состояние:
# сертификаты, база и журнал. Всё остальное для службы только для чтения.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
ReadWritePaths=/etc/hysteria-ward /var/lib/hysteria-ward /var/log/hysteria-ward

[Install]
WantedBy=multi-user.target
